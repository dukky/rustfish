# Settings for .github/workflows/speed-compare.yml on pushes to speed-diag.
# Refs are branch names (resolved as origin/<name>) or commits. Listing the
# base again as a candidate gives an A/A (noise) control.
BASE=origin/main
CANDS="origin/main qs-delta"
PROFILE=""
RUNNERS=6
ROUNDS=10
DEPTH=13
ALLOW_DIFF=1
