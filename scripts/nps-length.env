# Settings for .github/workflows/nps-length.yml on pushes to speed-diag.
# BINS: name=ref pairs (a ref listed twice = A/A control). PROFILE: ref to perf ("" = none).
BINS="main=origin/main aa=origin/main qsd=qs-delta mstats=main-stats qstats=qs-delta-stats"
HASHES="16 64"
MOVETIMES="100,1000,3000"
FENS=25
PROFILE=""
