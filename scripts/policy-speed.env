# Policy upper bounds, shape 2 cost side: dummy quiet scorer only at deep
# nodes (depth >= 6 / 8), cold out-of-line call after the picker is built,
# tree identical to main. origin/main twice = A/A noise control;
# policy-deep-d6never = hook compiled in, never scores (plumbing control).
BASE=origin/main
CANDS="origin/main policy-deep-d6never policy-deep-d6 policy-deep-d8 policy-deep-d6h256"
PROFILE=""
RUNNERS=6
ROUNDS=10
DEPTH=13
